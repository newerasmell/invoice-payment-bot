{# Shared page shell. Layouts override `style` and `body` and import blocks from _macros. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Invoice {{ inv.number }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Roboto:wght@400;500;700&family=Source+Serif+4:wght@400;600;700&family=IBM+Plex+Sans:wght@400;600;700&family=Courier+Prime:wght@400;700&family=IBM+Plex+Mono&display=swap" rel="stylesheet">
<style>
  @page { size: A4; margin: 16mm 16mm 18mm; }
  * { box-sizing: border-box; }
  html { background: #fff; }
  body { margin: 0; font-family: {{ o.font_stack | safe }}; font-size: 10pt; color: #1b1f24; line-height: 1.45; }
  .page { width: 178mm; margin: 0 auto; position: relative; }
  .muted { color: #6b7280; }
  .mono { font-family: 'IBM Plex Mono', 'Courier New', monospace; }
  .label { text-transform: uppercase; letter-spacing: .06em; font-size: 7.5pt; color: #6b7280; margin-bottom: 4px; font-weight: 600; }
  .party-name { font-weight: 700; font-size: 11pt; margin-bottom: 2px; }
  table { border-collapse: collapse; width: 100%; }
  .meta th { text-align: left; font-weight: 400; color: #6b7280; padding: 1px 12px 1px 0; white-space: nowrap; }
  .meta td { text-align: right; font-weight: 600; padding: 1px 0; }
  .lines { margin-top: 18px; }
  .lines th { font-size: 8pt; text-transform: uppercase; letter-spacing: .05em; text-align: left; padding: 8px 6px; }
  .lines td { padding: 8px 6px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
  .lines .r, .lines th.r { text-align: right; white-space: nowrap; }
  .lines .num { width: 24px; color: #6b7280; }
  .totals { width: 46%; margin-left: auto; margin-top: 14px; }
  .totals th { text-align: left; font-weight: 400; color: #4b5563; padding: 4px 6px; }
  .totals td { text-align: right; padding: 4px 6px; white-space: nowrap; }
  .totals .grand th, .totals .grand td { font-weight: 700; font-size: 12pt; padding-top: 8px; }
  .vat-note { font-size: 8.5pt; color: #4b5563; text-align: right; margin: 6px 0 0; }
  .bank { margin-top: 22px; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 4px; width: 60%; }
  .description, .notes { margin: 16px 0 0; }
  .header-note { margin: 0 0 14px; font-size: 9pt; }
  .footer-note { margin-top: 28px; padding-top: 10px; border-top: 1px solid #e5e7eb; font-size: 8.5pt; color: #4b5563; white-space: pre-line; }
  .signatures { margin-top: 44px; }
  .signatures td { width: 50%; padding-right: 30px; font-size: 9pt; color: #4b5563; vertical-align: bottom; }
  .sigline { border-bottom: 1px solid #9ca3af; height: 34px; margin-bottom: 4px; }
  .draft { position: absolute; top: 70mm; left: 0; right: 0; text-align: center; font-size: 72pt; font-weight: 700; color: rgba(220, 38, 38, .12); transform: rotate(-24deg); pointer-events: none; }
  {% block style %}{% endblock %}
</style>
</head>
<body>
<div class="page">
  {% if inv.is_draft %}<div class="draft">DRAFT</div>{% endif %}
  {% block body %}{% endblock %}
  {% if o.footer_note %}<div class="footer-note">{{ o.footer_note }}</div>{% endif %}
</div>
</body>
</html>
