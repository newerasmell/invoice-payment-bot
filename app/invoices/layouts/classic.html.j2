{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import party, meta, lines, totals, bank, notes, signature, logo with context %}
{% block style %}
  .band { background: {{ o.accent_color }}; color: #fff; padding: 16px 18px; border-radius: 4px; }
  .band table td { vertical-align: middle; }
  .band h1 { margin: 0; font-size: 22pt; letter-spacing: .08em; }
  .band .no { opacity: .85; font-size: 10pt; }
  .logo { max-height: 46px; max-width: 160px; background: #fff; padding: 4px; border-radius: 3px; }
  .parties { margin-top: 18px; }
  .parties > tbody > tr > td { width: 33.3%; vertical-align: top; padding-right: 12px; }
  .party { border: 1px solid #e5e7eb; border-top: 3px solid {{ o.accent_color }}; padding: 10px 12px; border-radius: 3px; }
  .lines thead th { background: {{ o.accent_color }}; color: #fff; }
  .totals .grand th, .totals .grand td { border-top: 2px solid {{ o.accent_color }}; color: {{ o.accent_color }}; }
{% endblock %}
{% block body %}
<div class="band">
  <table><tr>
    {% if o.logo_position == "left" %}<td style="width:1%;padding-right:14px">{{ logo() }}</td>{% endif %}
    <td><h1>{{ o.title }}</h1><div class="no">No {{ inv.number }}</div></td>
    {% if o.logo_position == "right" %}<td style="text-align:right">{{ logo() }}</td>{% endif %}
  </tr></table>
</div>
{% if o.header_note %}<p class="header-note" style="margin-top:12px">{{ o.header_note }}</p>{% endif %}
<table class="parties"><tr>
  <td>{{ party("Supplier", inv.supplier) }}</td>
  <td>{{ party("Customer", inv.customer) }}</td>
  <td style="padding-right:0">{{ meta() }}</td>
</tr></table>
{{ lines() }}
{{ totals() }}
{{ notes() }}
{{ bank() }}
{{ signature() }}
{% endblock %}
