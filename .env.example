# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed in as approvers on first start
BOOTSTRAP_APPROVER_IDS=

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
COMPANIES_FILE=config/companies.yaml

# Web admin panel at /admin (disabled while ADMIN_PASSWORD is empty)
ADMIN_PASSWORD=
# Long random string; signs the admin session cookie
SESSION_SECRET=
UPLOADS_DIR=data/uploads
HTTPS_ONLY_COOKIES=false

# mock | paynetics
BANK_PROVIDER=mock
PAYNETICS_BASE_URL=https://api.paynetics.online/v1
# One Paynetics account per company: PAYNETICS_<COMPANY CODE>_ACCESS_TOKEN / _SECRET_KEY
# (company code in upper case, "-" written as "_"), e.g. for company X:
PAYNETICS_X_ACCESS_TOKEN=
PAYNETICS_X_SECRET_KEY=
POLL_INTERVAL_SECONDS=120
POLL_LOOKBACK_HOURS=48

# Safety: in dry run no email reaches a real recipient
DRY_RUN=true
DRY_RUN_EMAIL=
MAX_INVOICE_AMOUNT=50000.00
MAX_PAYMENT_INSTRUCTION_AMOUNT=50000.00
# Above the two limits a second, different approver is needed (Admin -> Team).

# Reminders: overdue invoices / approved payments not seen in the bank
REMINDERS_ENABLED=true
REMINDER_CHECK_SECONDS=3600
REMINDER_REPEAT_HOURS=24
INSTRUCTION_TIMEOUT_HOURS=48

# Claude API (free-text invoice parsing)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Public URL for invoice links (on Render, RENDER_EXTERNAL_URL is used automatically)
PUBLIC_BASE_URL=http://localhost:8000

# Outgoing email. Leave SMTP_HOST empty to only record email deliveries as skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
